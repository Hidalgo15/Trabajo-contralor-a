<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema de la ventana mientras arranca el proceso (modo oscuro del SO) -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <!-- Splash mientras Flutter dibuja su primer frame. Se quita solo. -->
        <item name="android:windowBackground">@drawable/launch_background</item>
        <!-- Splash del sistema en Android 12+: mismo fondo azul profundo -->
        <item name="android:windowSplashScreenBackground">@color/splashBackground</item>
    </style>
    <!-- Tema aplicado apenas arranca el proceso, detrás de la UI de Flutter -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
